type: dataset
title: "La Tecnologia di Controfase — Volume 1: Fondamenti / The Technology of Controfase — Volume 1: Foundations"
authors:
  - family-names: "Ghioni"
    given-names: "Fabio"
    orcid: "https://orcid.org/0009-0009-0415-9434"
